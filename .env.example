# Paysafe API credentials from the Business Portal
# Public key (Key Username + Key Password) - used by Checkout on the client (base64-encoded by the server)
PAYSAFE_PUBLIC_USERNAME=your_public_key_username
PAYSAFE_PUBLIC_PASSWORD=your_public_key_password

# Private key - used server-side only for the Payments API
PAYSAFE_PRIVATE_USERNAME=your_private_key_username
PAYSAFE_PRIVATE_PASSWORD=your_private_key_password

# TEST or LIVE (defaults to TEST)
PAYSAFE_ENVIRONMENT=TEST

# Merchant account currency
PAYSAFE_CURRENCY=GBP

# Card account ID (required when multiple accounts share the same currency)
PAYSAFE_ACCOUNT_ID=1002720790

# Google Pay settings (set PAYSAFE_GOOGLEPAY_ENABLED=true only after configuring a valid merchant ID)
PAYSAFE_GOOGLEPAY_ENABLED=false
PAYSAFE_GOOGLEPAY_ACCOUNT_CC=1002720790
PAYSAFE_GOOGLEPAY_MERCHANT_ID=012345678987654321
PAYSAFE_GOOGLEPAY_LABEL=Deposit Demo
PAYSAFE_GOOGLEPAY_COUNTRY=GB

# Apple Pay settings (requires Apple Pay setup in the Paysafe Business Portal)
PAYSAFE_APPLEPAY_ENABLED=false
PAYSAFE_APPLEPAY_ACCOUNT_ID=1002720790
PAYSAFE_APPLEPAY_LABEL=Deposit Demo
PAYSAFE_APPLEPAY_COUNTRY=GB
PAYSAFE_APPLEPAY_COLOR=white-outline
PAYSAFE_APPLEPAY_TYPE=buy
PAYSAFE_APPLEPAY_SUPPORTED_COUNTRIES=GB,US

# Maximum withdrawal amount in minor units (default 50000 = 500.00)
PAYSAFE_MAX_WITHDRAWAL=50000

# Server port
PORT=4000
